# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- server (never bundled; used by `npm run server` and `npm run seed`) --
# Either provide a full connection string:
# MONGODB_URI=
# ...or the parts, and the server assembles it:
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# MONGODB_HOST=your-cluster.xxxxx.mongodb.net

# Point the dashboard at a Node/Express + ws backend instead of the local
# simulation. Leave unset to run the bundled race engine in the browser.
# VITE_RACE_WS_URL=ws://localhost:4000/race

# --- client (bundled into the build — never put secrets here) ------------
# Where the career API lives. Leave unset for a static deployment: the game
# then runs entirely on the browser's localStorage mirror. Unset in
# development it defaults to http://localhost:4000, so `npm run server`
# works with no configuration.
# VITE_CAREER_API_URL=https://your-api.example.com
# VITE_SAVE_SLOT=slot-1
